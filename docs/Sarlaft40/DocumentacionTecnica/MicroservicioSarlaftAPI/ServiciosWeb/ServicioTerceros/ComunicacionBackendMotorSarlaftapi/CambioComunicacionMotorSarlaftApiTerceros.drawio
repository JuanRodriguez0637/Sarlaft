        <mxCell id="sT9qvcKu3g03QGG-nfbJ-7" value="&lt;div&gt;&lt;b&gt;Controlador&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;ValidarTerceroService.validar&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;IN: EvaluacionTerceroQueryDto&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;OUT: ResponseEntity&amp;lt;RespuestaValidacionTerceroDTO&amp;gt;&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="HPjmBLleSZer_zQlOk8P-1" vertex="1">
