          <mxGeometry x="42" y="1330" width="724" height="270" as="geometry" />
        </mxCell>
        <mxCell id="wpNcojuseu8JtGHsgb8m-2" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;QueryEvaluacionTerceroDTO&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 10px; background-color: initial;&quot;&gt;- &lt;/span&gt;&lt;b style=&quot;font-size: 10px; background-color: initial;&quot;&gt;ValidacionesTerceroDTO:&lt;/b&gt;&lt;span style=&quot;font-size: 10px; background-color: initial;&quot;&gt; Objeto de sarlaftapi que se homologa al objeto &lt;/span&gt;&lt;b style=&quot;font-size: 10px; background-color: initial;&quot;&gt;FigurasVE&lt;/b&gt;&lt;span style=&quot;font-size: 10px; background-color: initial;&quot;&gt; en el motor. Ese objeto lo recibe el caso de uso &lt;/span&gt;&lt;b style=&quot;font-size: 10px; background-color: initial;&quot;&gt;ValidacionFiguraExternoUseCase.ejecutar&lt;/b&gt;&lt;span style=&quot;font-size: 10px; background-color: initial;&quot;&gt;. La idea de enviarlo por el ws al motor es no tener que construir el objeto &lt;/span&gt;&lt;b style=&quot;font-size: 10px; background-color: initial;&quot;&gt;FigurasVE&lt;/b&gt;&lt;span style=&quot;font-size: 10px; background-color: initial;&quot;&gt; en el motor sino que tome de una el que llega en el servicio.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;-&amp;nbsp;&lt;b&gt;QueryNewTipoFormularioRequisito:&lt;/b&gt;&amp;nbsp;Objeto de sarlaftapi que se homologa al objeto&amp;nbsp;&lt;b&gt;valuacionFE&lt;/b&gt;&amp;nbsp;en el motor. Ese objeto lo recibe el caso de uso&amp;nbsp;&lt;b&gt;IdentificarTipoFormularioRequsitosExternoUseCase.ejecutar&lt;/b&gt;. La idea de enviarlo por el ws al motor es no tener que construir el objeto &lt;b&gt;EvaluacionFE&lt;/b&gt; en el motor sino que tome de una el que llega en el servicio.&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="HPjmBLleSZer_zQlOk8P-1" vertex="1">
          <mxGeometry x="58" y="1330" width="310" height="250" as="geometry" />
        </mxCell>
        <mxCell id="wpNcojuseu8JtGHsgb8m-3" value="&lt;b&gt;Observaciones&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="HPjmBLleSZer_zQlOk8P-1" vertex="1">
          <mxGeometry x="42" y="1300" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="wpNcojuseu8JtGHsgb8m-4" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;RespuestaValidacionTerceroDTO&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;-&amp;nbsp;&lt;b&gt;FigurasVE&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 10px;&quot;&gt;:&lt;/b&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt; Objeto equivalente al&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: initial; font-size: 10px;&quot;&gt;&lt;b&gt;RespuestaQueryValidacionesTercerosDTO &lt;/b&gt;en sarlaftapi&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;-&amp;nbsp;&lt;b&gt;EvaluacionFE&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 10px;&quot;&gt;:&lt;/b&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt; Objeto equivalente&amp;nbsp; al&amp;nbsp;&lt;b&gt;ResponseNewTipoFormularioRequisitoDTO&lt;/b&gt;&amp;nbsp;en sarlaftapi.&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Estos dos objetos corresponden a las entradas de los casos de uso&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: initial; font-size: 10px;&quot;&gt;VerificarEvidenciasUseCase y&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-size: 10px;&quot;&gt;IdentificarRequisitosFormularioUseCase los cuales se van a reutilizar.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="HPjmBLleSZer_zQlOk8P-1" vertex="1">
          <mxGeometry x="428" y="1330" width="310" height="200" as="geometry" />
